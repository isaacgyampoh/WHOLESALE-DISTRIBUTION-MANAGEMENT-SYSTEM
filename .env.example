# Copy to .env.local and fill in. Never commit the real file.
# Values come from Supabase: Project Settings -> API.

# ---------------------------------------------------------------
# Safe to expose to the browser
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------
# PIN secret. SERVER ONLY. REQUIRED.
#
# Sign-in is a four-digit PIN. What the database stores is an HMAC of
# the PIN under this secret, so a copy of the database is not enough to
# recover anyone's PIN: without this value the digest cannot be reversed
# by trying all ten thousand possibilities.
#
# Generate one with:  openssl rand -hex 32
#
# Never give this a NEXT_PUBLIC_ prefix, and never commit the real value.
# Changing it invalidates every existing PIN, which then all need
# reissuing.
# ---------------------------------------------------------------
PIN_PEPPER=

# ---------------------------------------------------------------
# SERVER ONLY. The service role key bypasses row level security
# completely: every tenant boundary, driver restriction and manager
# category scope in this schema is void for anything holding it.
# Never expose it to the browser, never prefix it NEXT_PUBLIC_,
# and never commit it.
# ---------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------
# OPTIONAL. A direct Postgres connection, for running migrations with
# the Supabase CLI or psql. The application never uses it, and
# everything in docs/SUPABASE_SETUP.md can be done from the SQL editor
# without it.
#
# Supabase: Project Settings -> Database -> Connection string.
#
# Note that db.<ref>.supabase.co is IPv6-only. On a network without
# IPv6 it will not even resolve, and you want the SESSION POOLER string
# instead - same page, "Session pooler". Its username carries the
# project ref:
#
#   postgresql://postgres.<ref>:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------
SUPABASE_DB_URL=
