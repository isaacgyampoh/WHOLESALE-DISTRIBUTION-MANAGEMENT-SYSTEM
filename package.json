{
  "name": "wholesale-distribution-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "db:start": "npm --prefix tests/db run pg:start",
    "db:stop": "npm --prefix tests/db run pg:stop",
    "db:test": "npm --prefix tests/db test",
    "db:inspect": "npm --prefix tests/db run inspect",
    "hosted:preflight": "npm --prefix tests/hosted run preflight",
    "hosted:test": "npm --prefix tests/hosted test",
    "db:build-installer": "node database/build.mjs",
    "db:verify-installer": "cd tests/db && node test_installer.mjs",
    "hosted:auth": "npm --prefix tests/hosted run auth",
    "hosted:shell": "npm --prefix tests/hosted run shell",
    "visual": "npm --prefix tests/visual run shots",
    "test:unit": "node tests/unit/test_quantity.mjs",
    "demo:seed": "node scripts/demo/seed.mjs",
    "demo:clean": "node scripts/demo/clean.mjs",
    "hosted:workflow": "node tests/visual/test_workflow.mjs",
    "hosted:pages": "node tests/visual/test_pages.mjs",
    "hosted:offline": "node tests/visual/test_offline.mjs",
    "hosted:driver": "node tests/visual/test_driver_day.mjs",
    "icons": "node scripts/icons/generate.mjs",
    "visual:audit": "node tests/visual/audit.mjs",
    "production:clean": "node scripts/production/clean.mjs",
    "production:verify": "node scripts/production/verify.mjs",
    "db:set-password": "node scripts/db/set-password.mjs",
    "db:check": "node scripts/db/check.mjs",
    "production:bootstrap": "node scripts/production/bootstrap.mjs",
    "production:auth-flow": "node tests/production/auth-flow.mjs",
    "production:supplier-portal": "node tests/production/supplier-portal.mjs",
    "production:smoke": "node tests/production/smoke.mjs",
    "production:receipts": "node tests/production/receipts.mjs",
    "production:stock-count": "node tests/production/stock-count.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "unrs-resolver@1.12.2": true
  }
}
